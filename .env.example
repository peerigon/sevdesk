# Loaded only by `npm run smoke` (see vitest.smoke.config.ts). Never needed for `npm test`.
#
# This file is normally mounted by 1Password Environments rather than written by hand:
# 1Password app -> your Environment -> Connect to -> Local .env file -> pick this repo.
# The mount is a named pipe, so the token is served on demand and never lands on disk.
#
# Find the token in sevDesk under User -> Settings -> API.
SEVDESK_API_TOKEN=
